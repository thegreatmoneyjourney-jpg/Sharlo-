# Owner/migration connection — creates the app_user role, runs schema
# migrations, grants table privileges. Never used by request handlers.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sharlo

# Restricted connection request handlers actually use — subject to RLS.
# Same database as DATABASE_URL, different (unprivileged) role.
APP_DATABASE_URL=postgres://app_user:app_user_dev_password@localhost:5432/sharlo

# Password used when DATABASE_URL's role provisions app_user (must match the
# credentials in APP_DATABASE_URL above). A real deployment sources this
# from a secret, never a committed value — this file is an example only.
APP_DB_ROLE_PASSWORD=app_user_dev_password

PORT=4000
HOST=0.0.0.0
