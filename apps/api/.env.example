# Owner/migration connection — creates the app_user role, runs schema
# migrations, grants table privileges. Never used by request handlers.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sharlo

# Restricted connection request handlers actually use — subject to RLS.
# Same database as DATABASE_URL, different (unprivileged) role.
APP_DATABASE_URL=postgres://app_user:app_user_dev_password@localhost:5432/sharlo

# Password used when DATABASE_URL's role provisions app_user (must match the
# credentials in APP_DATABASE_URL above). A real deployment sources this
# from a secret, never a committed value — this file is an example only.
APP_DB_ROLE_PASSWORD=app_user_dev_password

PORT=4000
HOST=0.0.0.0

# ADR-0017 (M0-010) — the one integration-related env var this app has,
# on purpose: the envelope key that encrypts every row in
# integration_credentials (Resend, Paddle, Bank Alfalah, Google OAuth's
# client secret, ...). Every *actual* integration secret lives in that
# table (see `npm run db:set-credential`), not here. Generate with:
#   openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=replace-with-a-real-generated-32-byte-base64-key

# M3-001/M3-002 — the OAuth redirect_uri is built from this (must exactly
# match what's registered for the Google OAuth client), and it's also the
# CORS-allowed origin for cross-origin cookie-carrying requests from the
# web app. Dev defaults below assume `npm run dev:api`/`dev:web`'s default
# ports; a real deployment sets these to https://<API_DOMAIN>/https://<APP_DOMAIN>
# (docker-compose.yml derives them from those same values automatically).
API_BASE_URL=http://localhost:4000
APP_BASE_URL=http://localhost:3000

# Signs the OAuth handshake + session cookies (`@fastify/cookie`) so a
# tampered cookie value is detectable before it ever reaches a DB query —
# same "one foundational secret, not a rotatable third-party integration"
# category as INTEGRATION_CREDENTIALS_KEY above, for the same reason.
#   openssl rand -base64 32
COOKIE_SIGNING_SECRET=replace-with-a-different-real-generated-32-byte-base64-key
