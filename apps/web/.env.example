# For running `npm run dev -w web` directly (not via Docker). See
# docker-compose.yml for the production equivalent (baked in at image
# build time, not read at container-run time — see apps/web/Dockerfile).

# M3-003 — the API origin the browser calls directly for session-
# authenticated account endpoints (e.g. /account/encryption-*). Must be
# prefixed NEXT_PUBLIC_ to be readable by client components; Next.js
# inlines it into the built bundle at build time, so changing it requires
# a rebuild, not just a restart. Matches apps/api's own dev default port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
