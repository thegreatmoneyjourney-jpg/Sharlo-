# For running `npm run dev -w web` directly (not via Docker). See
# docker-compose.yml for the production equivalent (baked in at image
# build time, not read at container-run time — see apps/web/Dockerfile).

# M3-003 — the API origin the browser calls directly for session-
# authenticated account endpoints (e.g. /account/encryption-*). Must be
# prefixed NEXT_PUBLIC_ to be readable by client components; Next.js
# inlines it into the built bundle at build time, so changing it requires
# a rebuild, not just a restart. Matches apps/api's own dev default port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# M3-014/ADR-0010 — Google Picker's own quota-attribution key (Google
# Cloud Console > Credentials > API key), used by
# lib/drive/shared-drive-picker.ts so a Workspace school admin can select
# an existing Shared Drive they created themselves. Deliberately a
# NEXT_PUBLIC_* build-time var, not an integration_credentials row
# (ADR-0017): a Picker API key is restricted by HTTP referrer in Cloud
# Console and meant to be visible in client-side code by design, the
# same category as a Google Maps API key — not a secret the server needs
# to keep confidential. No real Google Cloud Console project exists for
# this app yet (same gap M1-011/M3-001/M3-006 already flag for other
# Google-integration surfaces) — replace with a real key once one does.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=replace-with-a-real-google-cloud-console-api-key
