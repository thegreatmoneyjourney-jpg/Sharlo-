# Dependencies
node_modules/

# Build outputs
.next/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Generated build-time vendor assets (apps/web/scripts/copy-opencv-asset.mjs)
apps/web/public/vendor/

# Generated detection-harness bundle (apps/web/scripts/build-detection-harness.mjs)
apps/web/tests/detection-harness/.generated/

# Ephemeral esbuild-for-Node bundle (apps/web/scripts/run-generate-stock-templates.mjs)
# — the stock template PDFs/seed data it produces ARE committed (public/templates/,
# lib/templates/stock-templates-seed.json); only this intermediate bundle isn't.
apps/web/scripts/.generated/

# Playwright test artifacts
apps/web/test-results/
apps/web/playwright-report/

# Env files — never commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Logs
npm-debug.log*
*.log

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/

# Docker volumes data (if ever mounted locally)
infra/pgdata/
