# Config for `docker compose up` on the VPS (infra/README.md). Copy this to
# `.env` in the repo root (gitignored — never commit real values) and fill
# in real secrets. Different from apps/api/.env.example, which is for
# running apps/api directly with `npm run dev`, not via Docker.

# --- Postgres (owner/migration credentials) ---
POSTGRES_USER=sharlo_owner
POSTGRES_PASSWORD=replace-with-a-real-generated-secret
POSTGRES_DB=sharlo

# --- Restricted app_user role the Fastify app actually queries through ---
# (ARCHITECTURE.md §8 — subject to Row-Level Security; never the owner role)
APP_DB_ROLE_PASSWORD=replace-with-a-different-real-generated-secret

# --- Domains Caddy issues TLS certificates for ---
# Point DNS A/AAAA records at this VPS's public IP *before* first
# `docker compose up`, or Let's Encrypt issuance fails. See infra/README.md.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
