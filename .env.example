# Config for `docker compose up` on the VPS (infra/README.md). Copy this to
# `.env` in the repo root (gitignored — never commit real values) and fill
# in real secrets. Different from apps/api/.env.example, which is for
# running apps/api directly with `npm run dev`, not via Docker.

# --- Postgres (owner/migration credentials) ---
POSTGRES_USER=sharlo_owner
POSTGRES_PASSWORD=replace-with-a-real-generated-secret
POSTGRES_DB=sharlo

# --- Restricted app_user role the Fastify app actually queries through ---
# (ARCHITECTURE.md §8 — subject to Row-Level Security; never the owner role)
APP_DB_ROLE_PASSWORD=replace-with-a-different-real-generated-secret

# --- Envelope key for integration_credentials (ADR-0017, M0-010) ---
# Encrypts every row in that table (Resend, Paddle, Bank Alfalah, Google
# OAuth's client secret, ...) — the one integration-related env var by
# design; every actual integration secret is stored via that table instead,
# never here. A different generated secret from the two above.
#   openssl rand -base64 32
INTEGRATION_CREDENTIALS_KEY=replace-with-a-third-real-generated-secret

# --- Signs OAuth handshake + session cookies (M3-001/M3-002) ---
# Same category as INTEGRATION_CREDENTIALS_KEY above (a foundational app
# secret, not a rotatable third-party credential) — a fourth, different
# generated secret.
#   openssl rand -base64 32
COOKIE_SIGNING_SECRET=replace-with-a-fourth-real-generated-secret

# --- Domains Caddy issues TLS certificates for ---
# Point DNS A/AAAA records at this VPS's public IP *before* first
# `docker compose up`, or Let's Encrypt issuance fails. See infra/README.md.
# Also what API_BASE_URL/APP_BASE_URL (docker-compose.yml) derive from —
# no separate entries needed for those.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
